#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        delete {
            bindings = <&kp DELETE>;
            key-positions = <40 18>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <18 19>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <19 20>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <20 21>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <18 20>;
        };

        up {
            bindings = <&kp UP_ARROW>;
            key-positions = <11 12 13 41>;
        };

        left {
            bindings = <&kp LEFT>;
            key-positions = <11 12 13 18>;
        };

        right {
            bindings = <&kp RIGHT>;
            key-positions = <11 12 13 20>;
        };

        down {
            bindings = <&kp DOWN>;
            key-positions = <11 12 13 21>;
        };

        home {
            bindings = <&kp HOME>;
            key-positions = <11 12 13 41 19>;
        };

        end {
            bindings = <&kp END>;
            key-positions = <11 12 13 19 21>;
        };

        pg_up {
            bindings = <&kp PG_UP>;
            key-positions = <11 12 13 41 18 20>;
        };

        pg_dn {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <11 12 13 18 20 21>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <11 12 13 18 21>;
        };

        japanese_mode {
            bindings = <&kp LANG1>;
            key-positions = <11 12 13 18 19 20>;
        };

        english_mode {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <11 12 13 41 21>;
        };

        jpn_eng_change {
            bindings = <&kp LANG5>;
            key-positions = <11 12 13 21 18 41>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp L         &kp U         &kp COMMA         &kp PERIOD                                   &kp F        &kp W              &lt 5 R  &kp Y  &kp P
&kp E      &kp I         &kp A         &mt LEFT_SHIFT O  &kp MINUS      &kp CARET      &kp SLASH      &kp K        &mt RIGHT_SHIFT T  &kp N    &kp S  &kp H
&kp Z      &kp X         &kp C         &kp V             &kp SEMICOLON  &kp COLON      &kp BSLH       &kp G        &kp D              &kp M    &kp J  &kp B
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_SHIFT    &lt 2 SPACE    &lt 3 TAB      &kp BACKSPACE  &lt 1 ENTER                                     &kp ESC
            >;
        };

        FUNCTION {
            bindings = <
&trans  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &trans                      &trans  &kp LBKT  &kp RBKT  &kp PIPE  &trans
&trans  &kp LS(N4)  &kp LS(N5)  &kp LS(N6)  &trans  &trans      &trans  &trans  &kp LPAR  &kp RPAR  &kp AT    &trans
&trans  &kp LS(N1)  &kp LS(N2)  &kp LS(N3)  &trans  &trans      &trans  &trans  &kp LBRC  &kp RBRC  &trans    &trans
&trans  &trans      &trans      &trans      &trans  &trans      &trans  &trans                                &trans
            >;
        };

        NUM {
            bindings = <
&kp SLASH  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp MINUS                      &trans  &kp F7  &kp F8  &kp F9  &kp F12
&kp ASTRK  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp PLUS   &trans      &trans  &trans  &kp F4  &kp F5  &kp F6  &kp F11
&trans     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &trans      &trans  &trans  &kp F1  &kp F2  &kp F3  &kp F10
&trans     &kp N0        &kp PERIOD    &trans        &trans     &trans      &trans  &trans                          &trans
            >;
        };

        ARROW {
            bindings = <
&kp C_VOL_UP    &kp LS(LG(LEFT))    &kp LG(UP_ARROW)    &kp LG(LS(RIGHT))    &kp C_BRI_UP                         &kp PG_UP  &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &kp LC(T)
&kp C_VOL_DN    &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &kp C_BRI_DN     &trans      &trans  &kp PG_DN  &kp LEFT         &kp DOWN  &kp RIGHT    &kp LC(W)
&kp LEFT_SHIFT  &kp C_PREV          &kp LG(C_PP)        &kp C_NEXT           &kp PRINTSCREEN  &trans      &trans  &trans     &kp HOME         &trans    &kp END      &trans
&trans          &trans              &trans              &trans               &trans           &trans      &trans  &trans                                             &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        game {
            bindings = <
&kp TAB         &kp Q   &kp W         &kp E   &kp R                          &trans  &kp N7  &kp N8  &kp N9  &trans
&kp LEFT_SHIFT  &kp A   &kp S         &kp D   &kp F      &kp G       &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&kp LCTRL       &kp Z   &kp X         &kp C   &kp V      &kp B       &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
&kp ESC         &trans  &kp LEFT_ALT  &trans  &kp SPACE  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
