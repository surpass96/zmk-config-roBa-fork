#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <behaviors/naginata.dtsi>

#define BASE 0       // 大西配列。IME オフ（英数）専用
#define NAGINATA 1   // 薙刀式 v18。IME オン（かな）専用
#define SYM 2
#define NUM 3
#define NAV 4
#define SYS 5
#define MOUSE 6
#define SCROLL 7
#define SNIPE 8

// 薙刀式以外のレイヤー（薙刀式レイヤーでは J+K・C+V などが編集モードなので、既存のコンボを止める）
#define NON_NG 0 2 3 4 5 6 7 8

// ホームロウモッド用: 反対側の手のキー＋親指キーが押された時だけ hold（修飾キー）として扱う

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36
#define KEYS_R 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 42
#define THUMBS 37 38 39 40 41

// MOUSE レイヤーは roBa_R.overlay の zip_temp_layer で自動 ON になる（レイヤー番号もそちらに記載）。
// スクロールはドライバの scroll-layers で判定する。

&trackball {
    scroll-layers = <SCROLL>;
    snipe-layers = <SNIPE>;   // 精密モード: SNIPE 中はカーソルが遅くなる（roBa_R.conf の SNIPE_CPI）
};

/ {
    combos {
        compatible = "zmk,combos";

        // IME 切替は人差し指＋中指、または中指＋薬指の同時押し（左 = 英数 / 右 = かな）
        // 文字を打った直後 150ms は同時押しとして扱わない（require-prior-idle-ms）ので、"ao" "nt" を速く打っても誤爆しない

        c_eisu {
            bindings = <&ng_off>;
            key-positions = <12 13>;   // 左: A + O
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <NON_NG>;
        };

        c_kana {
            bindings = <&ng_on>;
            key-positions = <18 19>;   // 右: T + N
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <NON_NG>;
        };

        c_eisu2 {
            bindings = <&ng_off>;
            key-positions = <11 12>;   // 左: I + A（中指＋薬指）
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <NON_NG>;
        };

        c_kana2 {
            bindings = <&ng_on>;
            key-positions = <19 20>;   // 右: N + S（中指＋薬指）
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <NON_NG>;
        };

        // 左手下段の隣り合った 2 キーで Undo / Copy / Paste（右手がボールの上にある時用）
        // zx / xc / cv はローマ字でも英語でもほぼ連続しないので誤爆しにくい
        // 両親指（Space + Enter）の同時押しで SYS（キーボード設定）。押している間だけ有効
        // Space は左手（BLE 経由で届く）、Enter は右手なので、左右の遅延を見込んで判定時間を長めにしている

        // 薙刀式本家の IME 切替: qwerty の J+H = かな（薙刀式オン）、F+G = 英数（薙刀式オフ）

        c_ng_on {
            bindings = <&ng_on>;
            key-positions = <17 18>;   // J + H の位置（BASE では K + T）
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
            layers = <NON_NG>;
        };

        c_ng_off {
            bindings = <&ng_off>;
            key-positions = <13 14>;   // F + G の位置
            timeout-ms = <50>;
            layers = <NAGINATA>;
        };

        c_sys {
            bindings = <&mo SYS>;
            key-positions = <38 41>;
            timeout-ms = <150>;
        };

        c_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;   // Z + X
            timeout-ms = <40>;
            layers = <NON_NG>;
        };

        c_copy {
            bindings = <&kp LC(C)>;
            key-positions = <23 24>;   // X + C
            timeout-ms = <40>;
            layers = <NON_NG>;
        };

        c_paste {
            bindings = <&kp LC(V)>;
            key-positions = <24 25>;   // C + V
            timeout-ms = <40>;
            layers = <NON_NG>;
        };
    };

    behaviors {
        mouse_off: mouse_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
        };

        mo_comma_qmark: mo_comma_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_COMMA_QMARK";
            bindings = <&kp COMMA>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_dot_excl: mo_dot_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_DOT_EXCL";
            bindings = <&kp DOT>, <&kp EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_minus_equal: mo_minus_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_MINUS_EQUAL";
            bindings = <&kp MINUS>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // BASE の記号の Shift: , → ?  . → !  - → =  ; → +

        mo_semi_plus: mo_semi_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_SEMI_PLUS";
            bindings = <&kp SEMI>, <&kp PLUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_slash_bslh: mo_slash_bslh {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_SLASH_BSLH";
            bindings = <&kp FSLH>, <&kp BSLH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // 左親指外側: 1 回押し = かな（IME オン） / 2 回押し = 英数（IME オフ）
        // NAV: 1 回押し = 再生/停止 / 2 回押し = 次の曲 / 3 回押し = 前の曲

        td_media: td_media {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MEDIA";
            #binding-cells = <0>;
            tapping-term-ms = <250>;
            bindings = <&kp C_PP>, <&kp C_NEXT>, <&kp C_PREV>;
        };

        td_ime: td_ime {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_IME";
            #binding-cells = <0>;
            bindings = <&ng_on>, <&ng_off>;
        };

        td_q_esc: td_q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESC>;

            tapping-term-ms = <200>;
        };

        // ホームロウモッド（左手）。E=Win / I=Alt / A=Ctrl / O=Shift（NAV の左ホーム段と同じ）

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // ホームロウモッド（右手）。T=Shift / N=Ctrl / S=Alt / H=Win

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };

        // ホームロウモッド（右手）。T=Shift / N=Ctrl / S=Alt / H=Win
    };

    // 自動マウス: クリックを離して 250ms 後に MOUSE レイヤーを解除する
    // （クリック直後に打った文字が T=左クリック などにならないように。250ms 以内ならダブルクリック・ドラッグ可）
    // マクロは 1 本のキューで順に実行されるので、続けてクリックすると 2 回目は前の 250ms の後に出る

    macros {
        // 薙刀式オン / オフ: IME を切り替えて薙刀式レイヤーに入る / BASE に戻る

        ng_on: ng_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG1 &kp INT4 &to NAGINATA>;
        };

        ng_off: ng_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &kp LANG2 &kp INT5 &to BASE>;
        };

        click_off_l: click_off_l {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mkp MB1>,
                <&macro_pause_for_release>,
                <&macro_wait_time 250>,
                <&macro_release>,
                <&mkp MB1>,
                <&macro_wait_time 0>,
                <&macro_tap>,
                <&mouse_off MOUSE>;
        };

        click_off_m: click_off_m {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_wait_time 250>,
                <&macro_release>,
                <&mkp MB3>,
                <&macro_wait_time 0>,
                <&macro_tap>,
                <&mouse_off MOUSE>;
        };

        click_off_r: click_off_r {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings =
                <&macro_press>,
                <&mkp MB2>,
                <&macro_pause_for_release>,
                <&macro_wait_time 250>,
                <&macro_release>,
                <&mkp MB2>,
                <&macro_wait_time 0>,
                <&macro_tap>,
                <&mouse_off MOUSE>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
&td_q_esc    &kp L         &kp U         &mo_comma_qmark  &mo_dot_excl                                   &kp F        &kp W          &lt SCROLL R  &kp Y             &kp P
&hml LGUI E  &hml LALT I   &hml LCTRL A  &hml LSHFT O     &mo_minus_equal  &kp ESC        &kp LG(TAB)    &kp K        &hmr RSHIFT T  &hmr RCTRL N  &hmr RIGHT_ALT S  &hmr RIGHT_WIN H
&kp Z        &kp X         &kp C         &kp V            &mo_semi_plus    &kp CLCK       &kp LG(LS(S))  &kp G        &kp D          &kp M         &kp J             &kp B
&kp LCTRL    &kp LEFT_WIN  &kp LEFT_ALT  &td_ime          &lt NUM SPACE      &lt SYM TAB      &kp BSPC       &lt NAV ENTER                                                 &kp DEL
            >;
        };

        // 薙刀式 v18（qwerty の位置で 30 キー＋センターシフト）。それ以外のキーは BASE のまま

        NAGINATA {
            display-name = "NAGINATA";
            bindings = <
&ng Q   &ng W   &ng E   &ng R   &ng T                       &ng Y   &ng U      &ng I    &ng O   &ng P
&ng A   &ng S   &ng D   &ng F   &ng G   &trans      &trans  &ng H   &ng J      &ng K    &ng L   &ng SEMI
&ng Z   &ng X   &ng C   &ng V   &ng B   &trans      &trans  &ng N   &ng M      &ng COMMA  &ng DOT  &ng SLASH
&trans  &trans  &trans  &trans  &ng SPACE  &trans   &trans  &trans                                &trans
            >;
        };

        // SYM（左親指 Space 長押し）
        //   覚え方: 左手 = 演算子・計算、右手 = 括弧・引用符・その他。対になる記号は上が開き・下が閉じの縦並び（[ ] ( ) { } < >）
        //   , . - は BASE と同じ位置。親指 = : ;。右下の端は空き
        //   連打する記号（== ++ // ** && \\ ||）は人差し指と中指。!= <= >= += *= は = への内向きロール、(" (' も内向き

        SYM {
            display-name = "SYM";
            bindings = <
&kp CARET  &kp LT     &kp EQUAL  &kp GT    &kp COLON                         &kp EXCL   &kp DQT   &kp SQT   &kp GRAVE  &kp QMARK
&kp BSLH   &kp FSLH   &kp STAR   &kp PLUS  &kp MINUS  &none       &none      &kp TILDE  &kp LBKT  &kp LPAR  &kp LBRC   &kp HASH
&kp DLLR   &kp PRCNT  &kp PIPE   &kp AMPS  &kp UNDER  &none       &none      &kp AT     &kp RBKT  &kp RPAR  &kp RBRC   &none
&trans     &trans     &trans     &trans    &trans     &trans      &kp EQUAL  &kp SEMI                                  &none
            >;
        };

        // NUM（左親指 Tab 長押し）
        //   右手 = 数字（上段 7 8 9、ホーム段 1 2 3、下段 4 5 6、親指 0）と数字に付く記号（内側の列 ~ . ¥、親指 : は SYM と同じ位置）、小指に括弧の縦並び ( )
        //   左手 = SYM の左手とまったく同じ（演算子・計算記号）

        NUM {
            display-name = "NUM";
            bindings = <
&kp CARET       &kp LT     &kp EQUAL  &kp GT    &kp COLON                       &kp HOME   &kp N7  &kp N8  &kp N9  &kp BSPC
&hml LWIN BSLH  &kp FSLH   &kp STAR   &kp PLUS  &kp MINUS  &none       &none    &kp EQUAL  &kp N1  &kp N2  &kp N3  &kp ENTER
&kp DLLR        &kp PRCNT  &kp PIPE   &kp AMPS  &kp UNDER  &none       &none    &kp END    &kp N4  &kp N5  &kp N6  &kp TAB
&trans          &trans     &trans     &trans    &trans     &trans      &kp DOT  &kp N0                             &kp DEL
            >;
        };

        // NAV（右親指 Enter 長押し）
        //   右手: 矢印（逆T字）と Home/End、内側の列 = 輝度 +/-、小指 = 音量 +/- とミュート、下段 = 範囲スクショ・デスクトップ表示
        //   左手: 上段 F1〜F5、下段 F6〜F10、内側 F11/F12、ホームロウ = 修飾キー（E/I/A/O = Win/Alt/Ctrl/Shift）＋ Esc

        NAV {
            display-name = "NAV";
            bindings = <
&kp F1    &kp F2    &kp F3     &kp F4     &kp F5                                      &kp LC(LS(T))  &kp RA(LEFT)     &kp UP     &kp RA(RIGHT)  &kp C_VOL_UP
&kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none    &kp F11      &kp C_BRIGHTNESS_INC  &kp LC(T)      &kp LEFT         &kp DOWN   &kp RIGHT      &kp C_VOL_DN
&kp F6    &kp F7    &kp F8     &kp F9     &kp F10  &kp F12      &kp C_BRIGHTNESS_DEC  &kp LC(W)      &kp RC(RS(TAB))  &td_media  &kp RC(TAB)    &kp C_MUTE
&trans    &trans    &trans     &trans     &trans   &trans       &trans                &trans                                                    &trans
            >;
        };

        // SYS（Space と Enter の同時押し）: キーボードの設定だけ
        //   左手上段 = BT 接続先 0〜4、左手下段 = 全 BT 解除（小指）/ USB・BT 切替（中指）/ BT 解除（人差し指）
        //   左右の内側の列: 中段 = 再起動、下段 = ブートローダ（押した側の半分にだけ効く）

        SYS {
            display-name = "SYS";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                                &none   &none  &none  &none  &none
&none           &none         &none         &none         &none         &sys_reset       &sys_reset   &none   &none  &none  &none  &none
&bt BT_CLR_ALL  &none         &out OUT_TOG  &bt BT_CLR    &none         &bootloader      &bootloader  &none   &none  &none  &none  &none
&trans          &trans        &trans        &trans        &trans        &trans           &trans       &trans                       &none
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp RC(RS(T))  &mkp MB4         &mo SCROLL    &mkp MB5      &kp RC(R)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RC(T)      &click_off_l     &click_off_m  &click_off_r  &mo SNIPE
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RC(W)      &kp RC(RS(TAB))  &trans        &kp RC(TAB)   &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                      &trans
            >;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        SNIPE {
            display-name = "SNIPE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
