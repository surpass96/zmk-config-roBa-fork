#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM 1
#define NAV 2
#define FUNC 3
#define MOUSE 4
#define SCROLL 5

// ホームロウモッド用: 反対側の手のキー＋親指キーが押された時だけ hold（修飾キー）として扱う
#define KEYS_L 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36
#define KEYS_R 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 42
#define THUMBS 37 38 39 40 41

// MOUSE レイヤーは roBa_R.overlay の zip_temp_layer で自動 ON になる（レイヤー番号もそちらに記載）。
// スクロールはドライバの scroll-layers で判定する。
&trackball {
    scroll-layers = <SCROLL>;
};

/ {
    combos {
        compatible = "zmk,combos";

        c_bkt {
            bindings = <&m_bkt>;
            key-positions = <19 20>;
        };

        c_par {
            bindings = <&m_par>;
            key-positions = <7 8>;
        };

        c_brc {
            bindings = <&m_brc>;
            key-positions = <31 32>;
        };

        c_dqt {
            bindings = <&m_dqt>;
            key-positions = <18 19>;
        };

        c_sqt {
            bindings = <&m_sqt>;
            key-positions = <6 7>;
        };

        c_grave {
            bindings = <&m_grave>;
            key-positions = <30 31>;
        };

        c_lang1 {
            bindings = <&kp LANG1>;
            key-positions = <18 19 20>;
        };

        // SYM レイヤー中（Space 長押し中）だけ有効。演算子を構成する 2 つの記号キーを同時押し
        c_arrow {
            bindings = <&m_arrow>;
            key-positions = <9 11>;    // -  +  >  →  ->
            layers = <SYM>;
        };

        c_neq {
            bindings = <&m_neq>;
            key-positions = <0 33>;    // !  +  =  →  !=
            layers = <SYM>;
        };

        c_le {
            bindings = <&m_le>;
            key-positions = <10 33>;   // <  +  =  →  <=
            layers = <SYM>;
        };

        c_ge {
            bindings = <&m_ge>;
            key-positions = <11 33>;   // >  +  =  →  >=
            layers = <SYM>;
        };

        c_lang2 {
            bindings = <&kp LANG2>;
            key-positions = <11 12 13>;
        };
    };

    macros {
        m_arrow: m_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "m_arrow";
        };

        m_neq: m_neq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCL &kp EQUAL>;
            label = "m_neq";
        };

        m_le: m_le {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp EQUAL>;
            label = "m_le";
        };

        m_ge: m_ge {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GT &kp EQUAL>;
            label = "m_ge";
        };

        m_par: m_par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "m_par";
        };

        m_bkt: m_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "m_bkt";
        };

        m_brc: m_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "m_brc";
        };

        m_dqt: m_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
            label = "m_dqt";
        };

        m_sqt: m_sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "m_sqt";
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp LEFT>;
            label = "m_grave";
        };
    };

    behaviors {
        mo_comma_excl: mo_comma_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_COMMA_EXCL";
            bindings = <&kp COMMA>, <&kp EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_dot_qmark: mo_dot_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_DOT_QMARK";
            bindings = <&kp DOT>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_minus_under: mo_minus_under {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_MINUS_UNDER";
            bindings = <&kp MINUS>, <&kp UNDER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };


        td_q_esc: td_q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESC>;

            tapping-term-ms = <200>;
        };

        td_lang1_lang2: td_lang1_lang2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANG1_LANG2";
            #binding-cells = <0>;
            bindings = <&kp LANG1>, <&kp LANG2>;
        };

        // ホームロウモッド（左手）。I=Alt / A=Ctrl / O=Shift
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // ホームロウモッド（右手）。T=Shift / N=Ctrl / S=Alt
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
&td_q_esc  &kp L         &kp U          &mo_comma_excl      &mo_dot_qmark                                      &kp F        &kp W               &lt SCROLL R        &kp Y              &kp P
&kp E      &hml LALT I   &hml LCTRL A   &hml LSHFT O        &mo_minus_under  &kp ESC              &kp LG(TAB)  &kp K        &hmr RSHFT T        &hmr RCTRL N        &hmr LALT S        &kp H
&kp Z      &kp X         &kp C          &kp V               &kp SEMI         &kp LC(LS(ESC))      &kp LG(V)    &kp G        &kp D               &kp M               &kp J              &kp B
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT   &td_lang1_lang2     &lt SYM SPACE    &lt FUNC TAB         &kp BSPC     &lt NAV ENTER                                                           &kp CAPS
            >;
        };

        // SYM（左親指 Space 長押し）
        //   右手内側 = :（BASE の ; と対）
        //   左上段 = US 配列の Shift+1〜5（! @ # $ %）、左中段 = 山括弧と引用符、左下段 = 括弧の入れ子 { [ ( ) ] }、左最下段 = \ | &
        //   右手 = テンキー＋演算子（^ はべき乗として数字の横）
        SYM {
            display-name = "SYM";
            bindings = <
&kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT                          &kp FSLH   &kp N7  &kp N8  &kp N9  &kp MINUS
&kp LT     &kp GT     &kp DQT    &kp SQT    &kp GRAVE  &kp TILDE   &kp COLON   &kp ASTRK  &kp N4  &kp N5  &kp N6  &kp PLUS
&kp LBRC   &kp LBKT   &kp LPAR   &kp RPAR   &kp RBKT   &kp RBRC    &kp CARET   &kp DOT    &kp N1  &kp N2  &kp N3  &kp EQUAL
&kp BSLH   &kp PIPE   &kp AMPS   &trans     &trans     &trans      &kp DEL     &kp N0                                    &kp ENTER
            >;
        };

        // NAV（右親指 Enter 長押し）
        //   右手: 移動。T/N/S/R = ←↓→↑（逆T字）、その周りに Home/End/PgUp/PgDn/Del/BS、下段 = 画面系
        //   左手: ホームロウ = 修飾キー（E/I/A/O = Win/Alt/Ctrl/Shift）、上段 = 音量・輝度、下段は Z X C V の位置のまま Undo/Cut/Copy/Paste
        NAV {
            display-name = "NAV";
            bindings = <
&kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP                     &kp DEL     &kp HOME       &kp UP     &kp END    &kp PG_UP
&kp LGUI    &kp LALT      &kp LCTRL     &kp LSHFT     &none         &trans      &trans  &kp BSPC    &kp LEFT       &kp DOWN   &kp RIGHT  &kp PG_DN
&kp LC(Z)   &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(Y)     &trans      &trans  &kp PSCRN   &kp LG(LS(S))  &kp LG(D)  &none      &none
&trans      &trans        &trans        &trans        &trans        &trans      &trans  &trans                                           &trans
            >;
        };

        // FUNC（左親指 Tab 長押し）
        //   右手: F キー。F1〜F9 は SYM レイヤーの数字 1〜9 と同じ位置、右端の列が F10〜F12、内側の列が F13〜F15
        //   左手: 上段 = BT 接続先 0〜4、ホームロウ = 修飾キー（I/A/O と同じ指 + 小指 Win）、下段・内側 = BT 解除・出力切替・リセット
        FUNC {
            display-name = "FUNC";
            bindings = <
&bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                           &kp F15  &kp F7  &kp F8  &kp F9  &kp F12
&kp LGUI        &kp LALT       &kp LCTRL     &kp LSHFT     &none         &sys_reset       &none   &kp F14  &kp F4  &kp F5  &kp F6  &kp F11
&bt BT_CLR      &out OUT_TOG   &none         &none         &none         &bootloader      &none   &kp F13  &kp F1  &kp F2  &kp F3  &kp F10
&bt BT_CLR_ALL  &none          &none         &trans        &trans        &trans           &trans  &trans                           &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp RC(RS(T))  &mkp MB4         &mo SCROLL  &mkp MB5     &kp RC(R)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RC(T)      &mkp MB1         &mkp MB3    &mkp MB2     &kp RC(F)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RC(W)      &kp RC(RS(TAB))  &kp ESC     &kp RC(TAB)  &kp RC(L)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
