#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define SYM 1
#define NUM 2
#define NAV 3
#define FUNC 4
#define MOUSE 5
#define SCROLL 6

// ホームロウモッド用: 反対側の手のキー＋親指キーが押された時だけ hold（修飾キー）として扱う

#define KEYS_L 0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36
#define KEYS_R 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 42
#define THUMBS 37 38 39 40 41

// MOUSE レイヤーは roBa_R.overlay の zip_temp_layer で自動 ON になる（レイヤー番号もそちらに記載）。
// スクロールはドライバの scroll-layers で判定する。

&trackball { scroll-layers = <SCROLL>; };

/ {
    combos {
        compatible = "zmk,combos";

        // IME 切替は人差し指＋中指の同時押し（左 = 英数 / 右 = かな）
        // "ao" "nt" などを速く打つと重なって誤爆しうるので、判定時間は短めにしている

        c_eisu {
            bindings = <&kp LANG2>;
            key-positions = <12 13>;   // 左: A + O
            timeout-ms = <30>;
        };

        c_kana {
            bindings = <&kp LANG1>;
            key-positions = <18 19>;   // 右: T + N
            timeout-ms = <30>;
        };

        // 左手下段の隣り合った 2 キーで Undo / Copy / Paste（右手がボールの上にある時用）
        // zx / xc / cv はローマ字でも英語でもほぼ連続しないので誤爆しにくい

        c_undo {
            bindings = <&kp LC(Z)>;
            key-positions = <22 23>;   // Z + X
            timeout-ms = <40>;
        };

        c_copy {
            bindings = <&kp LC(C)>;
            key-positions = <23 24>;   // X + C
            timeout-ms = <40>;
        };

        c_paste {
            bindings = <&kp LC(V)>;
            key-positions = <24 25>;   // C + V
            timeout-ms = <40>;
        };
    };

    behaviors {
        mo_comma_qmark: mo_comma_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_COMMA_QMARK";
            bindings = <&kp COMMA>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_dot_excl: mo_dot_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_DOT_EXCL";
            bindings = <&kp DOT>, <&kp EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_minus_equal: mo_minus_equal {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_MINUS_EQUAL";
            bindings = <&kp MINUS>, <&kp EQUAL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // BASE の記号の Shift: , → ?  . → !  - → =  ; → +

        mo_semi_plus: mo_semi_plus {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_SEMI_PLUS";
            bindings = <&kp SEMI>, <&kp PLUS>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_slash_bslh: mo_slash_bslh {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_SLASH_BSLH";
            bindings = <&kp FSLH>, <&kp BSLH>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        td_q_esc: td_q_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q_ESC";
            #binding-cells = <0>;
            bindings = <&kp Q>, <&kp ESC>;

            tapping-term-ms = <200>;
        };

        // 誤打防止: BT・再起動・ブートローダは 2 回連打した時だけ発動（1 回では何もしない）

        td_bt0: td_bt0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT0";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_SEL 0>;
        };

        td_bt1: td_bt1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT1";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_SEL 1>;
        };

        td_bt2: td_bt2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT2";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_SEL 2>;
        };

        td_bt3: td_bt3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT3";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_SEL 3>;
        };

        td_bt4: td_bt4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT4";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_SEL 4>;
        };

        td_bt_clr: td_bt_clr {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT_CLR";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_CLR>;
        };

        td_bt_clr_all: td_bt_clr_all {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BT_CLR_ALL";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bt BT_CLR_ALL>;
        };

        td_out_tog: td_out_tog {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_OUT_TOG";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&out OUT_TOG>;
        };

        td_reset: td_reset {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_RESET";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&sys_reset>;
        };

        td_boot: td_boot {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_BOOT";
            #binding-cells = <0>;
            tapping-term-ms = <300>;
            bindings = <&none>, <&bootloader>;
        };

        // BS: タップで BS、長押しで FUNC。タップ直後にもう一度押し続けると BS のリピート

        lt_func: lt_func {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_FUNC";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        // ホームロウモッド（左手）。I=Alt / A=Ctrl / O=Shift

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_R THUMBS>;
            hold-trigger-on-release;
        };

        // ホームロウモッド（右手）。T=Shift / N=Ctrl / S=Alt

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            hold-trigger-key-positions = <KEYS_L THUMBS>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "BASE";
            bindings = <
&td_q_esc  &kp L         &kp U         &mo_comma_qmark  &mo_dot_excl                                             &kp F          &kp W         &lt SCROLL R  &kp Y        &kp P
&kp E      &hml LALT I   &hml LCTRL A  &hml LSHFT O     &mo_minus_equal  &kp ESC             &kp LG(TAB)         &kp K          &hmr RSHFT T  &hmr RCTRL N  &hmr LALT S  &kp H
&kp Z      &kp X         &kp C         &kp V            &mo_semi_plus    &mo_slash_bslh      &kp LC(LS(ESC))     &kp G          &kp D         &kp M         &kp J        &kp B
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &sk LSHFT        &lt SYM SPACE    &lt NUM TAB         &lt_func FUNC BSPC  &lt NAV ENTER                                           &kp CAPS
            >;
        };

        // SYM（左親指 Space 長押し）
        //   覚え方: 左手 = 演算子・計算、右手 = 括弧・引用符・その他。対になる記号は上が開き・下が閉じの縦並び（[ ] ( ) { } < >）
        //   , . - は BASE と同じ位置。親指 = : ;。右下の端は空き
        //   連打する記号（== ++ // ** && \\ ||）は人差し指と中指。!= <= >= += *= は = への内向きロール、(" (' も内向き

        SYM {
            display-name = "SYM";
            bindings = <
&kp PRCNT  &kp UNDER  &kp FSLH   &kp COMMA  &kp DOT                           &kp TILDE  &kp BSLH  &kp PIPE  &kp AT    &kp HASH
&kp EXCL   &kp LT     &kp PLUS   &kp EQUAL  &kp MINUS  &none       &none      &kp DQT    &kp LBKT  &kp LPAR  &kp LBRC  &kp QMARK
&kp CARET  &kp GT     &kp ASTRK  &kp AMPS   &kp DLLR   &none       &none      &kp SQT    &kp RBKT  &kp RPAR  &kp RBRC  &kp GRAVE
&trans     &trans     &trans     &trans     &trans     &trans      &kp COLON  &kp SEMI                                 &none
            >;
        };

        // NUM（左親指 Tab 長押し）
        //   右手 = 数字（上段 7 8 9、ホーム段 1 2 3、下段 4 5 6、親指 . 0）と数字に付く記号（内側の列 ~ : ¥）、小指に括弧の縦並び ( )
        //   左手 = SYM の左手とまったく同じ（演算子・計算記号）
        NUM {
            display-name = "NUM";
            bindings = <
&kp PRCNT   &kp UNDER   &kp FSLH    &kp COMMA   &kp DOT     &kp TILDE   &kp N7      &kp N8      &kp N9      &none
&kp EXCL    &kp LT      &kp PLUS    &kp EQUAL   &kp MINUS   &none       &none       &kp COLON   &kp N1      &kp N2      &kp N3      &kp LPAR
&kp CARET   &kp GT      &kp ASTRK   &kp AMPS    &kp DLLR    &none       &none       &kp BSLH    &kp N4      &kp N5      &kp N6      &kp RPAR
&trans      &trans      &trans      &trans      &trans      &trans      &kp DOT     &kp N0      &none
            >;
        };

        // NAV（右親指 Enter 長押し）
        //   右手: 移動。T/N/S/R = ←↓→↑（逆T字）、その周りに Home/End/PgUp/PgDn/Del/BS、→ の下に Enter、下段 = 画面系
        //   左手: ホームロウ = 修飾キー（E/I/A/O = Win/Alt/Ctrl/Shift）＋ Esc、上段 = 音量・輝度、下段は Z X C V の位置のまま Undo/Cut/Copy/Paste

        NAV {
            display-name = "NAV";
            bindings = <
&kp K_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp C_BRI_DN  &kp C_BRI_UP                      &kp DEL    &kp HOME       &kp UP     &kp END    &kp PG_UP
&kp LGUI    &kp LALT      &kp LCTRL     &kp LSHFT     &kp ESC       &trans      &trans  &kp BSPC   &kp LEFT       &kp DOWN   &kp RIGHT  &kp PG_DN
&kp LC(Z)   &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(Y)     &trans      &trans  &kp PSCRN  &kp LG(LS(S))  &kp LG(D)  &kp ENTER &none
&trans      &trans        &trans        &trans        &trans        &trans      &trans  &trans                                          &trans
            >;
        };

        // FUNC（右親指 BS 長押し）
        //   左手: F1〜F12 を読む順（上段 F1〜F4、中段 F5〜F8、下段 F9〜F12）＋タスクマネージャ
        //   右手: ホームロウ = 修飾キー（T/N/S/H = Shift/Ctrl/Alt/Win）、上段 = BT 接続先 0〜4、下段 = BT 解除 / USB・BT 切替 / 全 BT 解除
        //   左右の内側の列: 中段 = 再起動、下段 = ブートローダ（押した側の半分にだけ効く）
        //   BT・再起動・ブートローダはすべて 2 回連打で発動

        FUNC {
            display-name = "FUNC";
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &none                                      &td_bt0  &td_bt1     &td_bt2      &td_bt3   &td_bt4
&kp F5  &kp F6   &kp F7   &kp F8   &kp LC(LS(ESC))  &td_reset      &td_reset  &none    &kp RSHFT   &kp RCTRL    &kp LALT  &kp RGUI
&kp F9  &kp F10  &kp F11  &kp F12  &none            &td_boot       &td_boot   &none    &td_bt_clr  &td_out_tog  &none     &td_bt_clr_all
&trans  &trans   &trans   &trans   &trans           &trans         &trans     &trans                                      &trans
            >;
        };

        MOUSE {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &kp RC(RS(T))  &mkp MB4         &mo SCROLL  &mkp MB5     &kp RC(R)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RC(T)      &mkp MB1         &mkp MB3    &mkp MB2     &kp RC(F)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &kp RC(W)      &kp RC(RS(TAB))  &kp ESC     &kp RC(TAB)  &kp RC(L)
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                                   &trans
            >;
        };

        SCROLL {
            display-name = "SCROLL";
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };
    };
};
