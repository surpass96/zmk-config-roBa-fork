#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        c_bkt {
            bindings = <&m_bkt>;
            key-positions = <19 20>;
        };

        c_par {
            bindings = <&m_par>;
            key-positions = <7 8>;
        };

        c_brc {
            bindings = <&m_brc>;
            key-positions = <31 32>;
        };

        c_dqt {
            bindings = <&m_dqt>;
            key-positions = <18 19>;
        };

        c_sqt {
            bindings = <&m_sqt>;
            key-positions = <6 7>;
        };

        c_grave {
            bindings = <&m_grave>;
            key-positions = <30 31>;
        };
    };

    macros {
        m_par: m_par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "m_par";
        };

        m_bkt: m_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "m_bkt";
        };

        m_brc: m_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "m_brc";
        };

        m_dqt: m_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
            label = "m_dqt";
        };

        m_sqt: m_sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "m_sqt";
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp LEFT>;
            label = "m_grave";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        o24 {
            bindings = <
&kp Q      &kp L         &kp U         &kp COMMA         &kp PERIOD                                 &kp F        &kp W              &lt 5 R  &kp Y  &kp P
&kp E      &kp I         &kp A         &mt LEFT_SHIFT O  &kp MINUS    &kp CARET      &kp CARET      &kp K        &mt RIGHT_SHIFT T  &kp N    &kp S  &kp H
&kp Z      &kp X         &kp C         &kp V             &kp SEMI     &kp COLON      &kp AT         &kp G        &kp D              &kp M    &kp J  &kp B
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &kp LEFT_SHIFT    &lt 2 SPACE  &lt 3 TAB      &kp BACKSPACE  &lt 1 ENTER                                     &kp ESC
            >;
        };

        FUNCTION {
            bindings = <
&kp EXCL  &kp N2  &kp HASH  &kp DLLR  &kp PRCNT                      &kp AMPS  &kp N7  &kp N8   &kp N9   &kp N0
&kp N1    &kp N2  &kp N3    &kp N4    &kp N5     &kp N5      &kp N6  &kp N6    &kp N7  &kp N8   &kp N9   &kp N0
&kp F1    &kp F2  &kp F3    &kp F4    &kp F5     &kp F6      &kp F7  &kp F8    &kp F9  &kp F10  &kp F11  &kp F12
&trans    &trans  &trans    &trans    &trans     &trans      &trans  &trans                              &trans
            >;
        };

        NUM {
            bindings = <
&kp F1  &kp F2   &kp F3   &kp F4   &kp ESC                                &kp FSLH    &kp N7  &kp N8  &kp N9  &kp ASTRK
&kp F5  &kp F6   &kp F7   &kp F8   &kp PRINTSCREEN  &none       &none     &kp N0      &kp N4  &kp N5  &kp N6  &kp PLUS
&kp F9  &kp F10  &kp F11  &kp F12  &none            &none       &none     &kp PERIOD  &kp N1  &kp N2  &kp N3  &kp MINUS
&none   &none    &none    &trans   &trans           &trans      &kp BSPC  &kp EQUAL                           &none
            >;
        };

        ARROW {
            bindings = <
&kp C_VOL_UP    &kp LS(LG(LEFT))    &kp LG(UP_ARROW)    &kp LG(LS(RIGHT))    &kp C_BRI_UP                         &kp PG_UP  &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &kp LC(T)
&kp C_VOL_DN    &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &kp C_BRI_DN     &trans      &trans  &kp PG_DN  &kp LEFT         &kp DOWN  &kp RIGHT    &kp LC(W)
&kp LEFT_SHIFT  &kp C_PREV          &kp LG(C_PP)        &kp C_NEXT           &kp PRINTSCREEN  &trans      &trans  &trans     &kp HOME         &trans    &kp END      &trans
&trans          &trans              &trans              &trans               &trans           &trans      &trans  &trans                                             &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        game {
            bindings = <
&kp TAB         &kp Q      &kp X         &kp E     &kp R                            &trans  &kp N7  &kp N8  &kp N9  &trans
&kp LEFT_SHIFT  &kp A      &kp W         &kp D     &kp F      &kp G         &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&kp LCTRL       &kp Z      &kp S         &kp C     &kp V      &kp B         &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
&kp ESC         &kp ENTER  &kp LEFT_ALT  &mkp MB4  &kp SPACE  &mkp MB5      &trans  &trans                          &trans
            >;
        };
    };
};
