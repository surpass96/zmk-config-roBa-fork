#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&trackball {
    automouse-layer = <4>;
    scroll-layers = <5>;

    // arrows {
    //     layers = <3>;
    //     bindings =
    //         <&kp RIGHT_ARROW>,
    //         <&kp LEFT_ARROW>,
    //         <&kp UP_ARROW>,
    //         <&kp DOWN_ARROW>;
    //     tick = <10>;
    //     wait-ms = <5>;
    //     tap-ms = <5>;
    // };
};

/ {
    combos {
        compatible = "zmk,combos";

        c_bkt {
            bindings = <&m_bkt>;
            key-positions = <19 20>;
        };

        c_par {
            bindings = <&m_par>;
            key-positions = <7 8>;
        };

        c_brc {
            bindings = <&m_brc>;
            key-positions = <31 32>;
        };

        c_dqt {
            bindings = <&m_dqt>;
            key-positions = <18 19>;
        };

        c_sqt {
            bindings = <&m_sqt>;
            key-positions = <6 7>;
        };

        c_grave {
            bindings = <&m_grave>;
            key-positions = <30 31>;
        };

        c_lang1 {
            bindings = <&kp LANG1>;
            key-positions = <18 19 20>;
        };

        c_lang2 {
            bindings = <&kp LANG2>;
            key-positions = <11 12 13>;
        };
    };

    macros {
        m_par: m_par {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR &kp LEFT>;
            label = "m_par";
        };

        m_bkt: m_bkt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBKT &kp RBKT &kp LEFT>;
            label = "m_bkt";
        };

        m_brc: m_brc {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC &kp LEFT>;
            label = "m_brc";
        };

        m_dqt: m_dqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp LEFT>;
            label = "m_dqt";
        };

        m_sqt: m_sqt {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp SQT &kp SQT &kp LEFT>;
            label = "m_sqt";
        };

        m_grave: m_grave {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp GRAVE &kp LEFT>;
            label = "m_grave";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        mo_comma_excl: mo_comma_excl {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_COMMA_EXCL";
            bindings = <&kp COMMA>, <&kp EXCL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_dot_qmark: mo_dot_qmark {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_DOT_QMARK";
            bindings = <&kp DOT>, <&kp QMARK>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_minus_tilde: mo_minus_tilde {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_MINUS_TILDE";
            bindings = <&kp MINUS>, <&kp TILDE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mo_fslh_under: mo_fslh_under {
            compatible = "zmk,behavior-mod-morph";
            label = "MO_FSLH_UNDER";
            bindings = <&kp FSLH>, <&kp UNDER>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        o24 {
            bindings = <
&kp Q      &kp L         &kp U         &kp COMMA         &kp PERIOD                             &kp F        &kp W              &kp R    &kp Y  &kp P
&kp E      &kp I         &kp A         &mt LEFT_SHIFT O  &kp MINUS    &kp AT         &kp COLON  &kp K        &mt RIGHT_SHIFT T  &lt 5 N  &kp S  &kp H
&kp Z      &kp X         &kp C         &kp V             &kp FSLH     &kp BSLH       &kp SEMI   &kp G        &kp D              &kp M    &kp J  &kp B
&kp LCTRL  &kp LEFT_WIN  &kp LEFT_ALT  &lt 3 LANG2       &lt 1 SPACE  &lt 2 TAB      &kp BSPC   &lt 2 ENTER                                     &kp ESC
            >;
        };

        NUM {
            bindings = <
&kp COLON  &kp DOUBLE_QUOTES  &kp TILDE  &kp EXCL  &kp QMARK                       &kp FSLH   &kp N7  &kp N8  &kp N9  &kp MINUS
&kp BSLH   &kp AMPS           &kp HASH   &kp LBKT  &kp TILDE  &none       &none    &kp ASTRK  &kp N4  &kp N5  &kp N6  &kp PLUS
&kp DLLR   &kp AT             &kp PRCNT  &kp LPAR  &kp BSLH   &none       &none    &kp N0     &kp N1  &kp N2  &kp N3  &kp UNDER
&none      &none              &none      &trans    &trans     &trans      &kp DEL  &kp EQUAL                          &none
            >;
        };

        FUNCTION {
            bindings = <
&kp EXCL  &kp CARET  &kp HASH  &kp DLLR  &kp PRCNT                           &kp AMPS  &kp TILDE  &kp PIPE  &kp F11  &kp F12
&kp N1    &kp N2     &kp N3    &kp N4    &kp N5     &kp ASTRK      &kp PLUS  &kp N6    &kp N7     &kp N8    &kp N9   &kp N0
&kp F1    &kp F2     &kp F3    &kp F4    &kp F5     &kp F6         &kp F7    &kp F8    &kp F9     &kp F10   &kp F11  &kp F12
&trans    &trans     &trans    &trans    &trans     &trans         &kp BSPC  &trans                                  &trans
            >;
        };

        ARROW {
            bindings = <
&kp C_VOL_UP    &kp LS(LG(LEFT))    &kp LG(UP_ARROW)    &kp LG(LS(RIGHT))    &kp C_BRI_UP                         &kp PG_UP  &kp LS(LC(TAB))  &kp UP    &kp LC(TAB)  &kp LC(T)
&kp C_VOL_DN    &kp LG(LEFT_ARROW)  &kp LG(DOWN_ARROW)  &kp LG(RIGHT_ARROW)  &kp C_BRI_DN     &trans      &trans  &kp PG_DN  &kp LEFT         &kp DOWN  &kp RIGHT    &kp LC(W)
&kp LEFT_SHIFT  &kp C_PREV          &kp LG(C_PP)        &kp C_NEXT           &kp PRINTSCREEN  &trans      &trans  &trans     &kp HOME         &trans    &kp END      &trans
&trans          &trans              &trans              &trans               &trans           &trans      &trans  &trans                                             &trans
            >;
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB1  &none     &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &mkp MB4  &mkp MB3  &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                                &trans
            >;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                      &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans  &trans                          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans        &trans        &trans        &trans                           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans        &trans        &trans        &trans        &trans
&trans  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans  &trans      &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans        &trans        &trans        &trans  &trans      &trans       &trans                                                  &bt BT_CLR_ALL
            >;
        };

        game {
            bindings = <
&kp TAB         &kp Q      &kp X         &kp E     &kp R                            &trans  &kp N7  &kp N8  &kp N9  &trans
&kp LEFT_SHIFT  &kp A      &kp W         &kp D     &kp F      &kp G         &trans  &trans  &kp N4  &kp N5  &kp N6  &trans
&kp LCTRL       &kp Z      &kp S         &kp C     &kp V      &kp B         &trans  &trans  &kp N1  &kp N2  &kp N3  &trans
&kp ESC         &kp ENTER  &kp LEFT_ALT  &mkp MB4  &kp SPACE  &mkp MB5      &trans  &trans                          &trans
            >;
        };
    };
};
